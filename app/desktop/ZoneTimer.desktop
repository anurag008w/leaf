[Desktop Entry]
Name=Zone Timer
Comment=Floating desktop timer for Zone Study OS
Exec=bash -c 'cd "$(dirname %k)" && ([ -f timer.py ] && python3 timer.py 2>/dev/null || x-terminal-emulator -e bash ZoneTimer.sh)'
Icon=preferences-system-time
Terminal=false
Type=Application
Categories=Utility;Education;
StartupNotify=false
Keywords=timer;focus;study;zone;
